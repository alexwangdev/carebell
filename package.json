{
  "name": "carebell",
  "version": "1.0.0",
  "private": true,
  "description": "CareBell turns Ring doorbell events into accessible household alerts.",
  "main": "server.ts",
  "scripts": {
    "start": "tsc -p public --pretty false && tsx server.ts",
    "start:app": "npm --prefix app run web",
    "typecheck": "tsc --noEmit && tsc -p public --noEmit --pretty false && npm --prefix app run typecheck",
    "build:web": "tsc -p public --pretty false",
    "test": "tsx --test \"test/**/*.test.ts\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.686.0",
    "@aws-sdk/lib-dynamodb": "^3.686.0",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "ffmpeg-static": "^5.3.0",
    "jpeg-js": "^0.4.4",
    "onnxruntime-node": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
